# Copy to supabase/.env and run: supabase secrets set --env-file supabase/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in deployed functions.)

# Sandbox first (keys/plans/webhooks from sandbox.whop.com). Delete this line to go live.
WHOP_API_BASE=https://sandbox-api.whop.com/api/v1
WHOP_API_KEY=                 # Dashboard → Developer → Account API Keys (Admin role is fine today)
WHOP_WEBHOOK_SECRET=          # ws_… shown when you create the webhook
WHOP_PLAN_STARTER=plan_
WHOP_PLAN_STANDARD=plan_
WHOP_PLAN_PRO=plan_

# Where Whop sends the founder after paying. {study_id} is replaced. Whop appends ?payment=…&status=…
CHECKOUT_REDIRECT_URL=https://YOUR-APP.lovable.app/results/{study_id}

# Person 2's planner endpoint (optional — if unset, agents poll for status='paid')
AGENT_TRIGGER_URL=
AGENT_TRIGGER_SECRET=
